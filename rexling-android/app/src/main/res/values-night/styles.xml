<resources>
    <!-- Dark twin of values/styles.xml: the canvas and bar glyphs of the built-in dark theme,
         so the first frame matches what RexTheme draws a moment later. -->
    <color name="launch_canvas">#090c11</color>
    <style name="Theme.Rex" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
